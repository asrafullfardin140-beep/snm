{
  "rewrites": [
    {
      "source": "/design-draft/preview/:path*",
      "destination": "/studio-a7k2/preview/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/design-draft/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/design-draft/preview/Main.html",
      "permanent": false
    }
  ]
}
